# Build-time configuration for the production bundle.
#
# These values are compiled into the client bundle by Vite, so they are public
# by definition. No secrets belong in this file.
#
# Vite automatically loads this file for `vite build` (mode = production), so a
# fresh clone builds against Midnight Preview with no dashboard configuration.

VITE_NETWORK=preview
VITE_COUNTER_ADDRESS=103ef1adb05ba6ce1391ab40d61e7e756245f4322c300abfa582b4ba5e4467bb
